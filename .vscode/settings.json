{
  "[javascript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[javascriptreact]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[typescript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[typescriptreact]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[vue]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "cSpell.language": "en,ru",
  "cSpell.words": [
    "десктопная",
    "десктопных",
    "инпута",
    "инпуте",
    "фронтенд",
    "composables",
    "consola",
    "formkit",
    "headlessui",
    "heroicons",
    "maxlength",
    "noopener",
    "noreferrer",
    "Nuxt",
    "nuxthub",
    "nuxtjs",
    "ofetch",
    "Shiki",
    "tailwindcss",
    "typecheck",
    "unixepoch",
    "unref",
    "vite",
    "vueuse"
  ],
  "editor.codeActionsOnSave": { "source.fixAll": "explicit" },
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.tabSize": 2,
  "eslint.validate": ["javascript", "json", "jsonc", "vue", "typescript", "yaml"],
  "files.associations": { "*.css": "tailwindcss" },
  "git.branchProtection": ["main"],
  "i18n-ally.displayLanguage": "ru",
  "i18n-ally.enabledFrameworks": ["vue", "vue-sfc"],
  "i18n-ally.keystyle": "nested",
  "i18n-ally.localesPaths": ["i18n/locales"],
  "i18n-ally.sourceLanguage": "ru",
  "oxc.disableNestedConfig": true,
  "oxc.enable.oxlint": false,
  "oxc.fmt.disableNestedConfig": true,
  "tailwindCSS.emmetCompletions": true,
  "typescript.tsdk": "node_modules/typescript/lib"
}
